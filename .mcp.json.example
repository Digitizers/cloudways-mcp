{
  "_comment": "Multi-account JSON shape for reference. Do NOT copy over .mcp.json — that file is now committed and must never contain a real token (its secrets stay ${VAR} env placeholders). Nor should a real token go here: every secret below is a ${VAR} env PLACEHOLDER, which Claude Code expands from its own environment (this works for local- and user-scoped entries in ~/.claude.json too, not only a project .mcp.json). Give each account its own variable name and export them where Claude Code starts; the header sent is always X-Access-Token, only the source differs, which is what keeps the accounts separated. A literal here would sit in plaintext in whatever file you paste it into - see references/installation.md, 'Handling the token safely'. One connection per Cloudways account, named cloudways-<client>. Endpoint and headers follow the official support article (https://support.cloudways.com/en/articles/14654372): the hosted MCP is at https://mcp.cloudways.com/mcp/, authenticated via the case-sensitive headers X-Access-Token and X-Mcp-Host. Generate an Access Token at platform.cloudways.com (API section) with the minimum role the connection needs: READ for monitoring-only, LIMITED for specific workflows, FULL ACCESS only when changes are required. Legacy X-CW-Email/X-CW-Api-Key headers are deprecated; the old API key stops working on October 15, 2026.",
  "mcpServers": {
    "cloudways-clientA": {
      "type": "http",
      "url": "https://mcp.cloudways.com/mcp/",
      "headers": {
        "X-Access-Token": "${CLOUDWAYS_TOKEN_CLIENTA:-}",
        "X-Mcp-Host": "claude-code"
      }
    },
    "cloudways-clientB": {
      "type": "http",
      "url": "https://mcp.cloudways.com/mcp/",
      "headers": {
        "X-Access-Token": "${CLOUDWAYS_TOKEN_CLIENTB:-}",
        "X-Mcp-Host": "claude-code"
      }
    }
  }
}
